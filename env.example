# Customer Intelligence Studio - environment variables
#
# Copy this file to .env for local development.
# Every variable is OPTIONAL. The application is fully functional without any of them:
# dashboards, segmentation, anomaly detection, data quality, the deterministic insights
# engine and Ask the Data all work with no key configured.
#
# NEVER commit a real key. .env is git-ignored.

# Enables the optional natural-language wording layer on the Ask the Data page and the
# executive brief. Without it, computed answers are shown exactly as calculated.
OPENAI_API_KEY=

# Model used for that wording layer.
CIS_OPENAI_MODEL=gpt-4o-mini

# On Streamlit Community Cloud, set OPENAI_API_KEY under
# App settings -> Secrets instead of using a file.
